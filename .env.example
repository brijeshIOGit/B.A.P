# Copy this file to .env and fill in your key. .env is gitignored: never commit it.
# With no key, CodeForge runs fully offline (rule-based brain + template library).

# Provider: groq (default, open-weight gpt-oss models) | offline
# (xai, openai and ollama are also wired in src/codeforge/config.py if ever needed)
MODEL_PROVIDER=groq

# Groq key: https://console.groq.com/keys
GROQ_API_KEY=

# Models (same as the bootcamp notebook)
CODEFORGE_BIG_MODEL=openai/gpt-oss-120b
CODEFORGE_SMALL_MODEL=openai/gpt-oss-20b
CODEFORGE_BACKUP_MODEL=openai/gpt-oss-20b

# Sandbox timeout in seconds, and the chaos rate (0.0 - 1.0)
CODEFORGE_SANDBOX_TIMEOUT=10
CODEFORGE_CHAOS=0

# Embeddings for the semantic cache: hash (offline, default) or minilm (optional extra)
CODEFORGE_EMBEDDINGS=hash

# Optional LangSmith tracing (only ever sees masked text)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
