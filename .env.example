# Copy this file to .env and fill in what you have. .env is gitignored: never commit it.
# With no key at all, CodeForge runs fully offline (rule-based brain + template library).

# Which provider to use: groq | xai | openai | ollama | offline
# Leave empty to pick automatically from whichever key is set (groq, then xai, then openai).
MODEL_PROVIDER=

# Groq (groq.com, the bootcamp notebook's provider)
GROQ_API_KEY=

# xAI Grok (x.ai)
XAI_API_KEY=

# OpenAI (optional)
OPENAI_API_KEY=

# Model names (leave empty for the provider defaults in src/codeforge/config.py)
CODEFORGE_BIG_MODEL=
CODEFORGE_SMALL_MODEL=
CODEFORGE_BACKUP_MODEL=

# Ollama (fully local), e.g. qwen2.5-coder
OLLAMA_MODEL=

# Sandbox timeout in seconds, and the chaos rate (0.0 - 1.0)
CODEFORGE_SANDBOX_TIMEOUT=10
CODEFORGE_CHAOS=0

# Embeddings for the semantic cache: hash (offline, default) or minilm (needs the optional extra)
CODEFORGE_EMBEDDINGS=hash

# Optional LangSmith tracing (only ever sees masked text)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
